{
  "name": "device-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Espelha e controla um Android pelo navegador, com DevTools (CPU, memória, rede, requisições, logcat, apps, FPS).",
  "license": "MIT",
  "author": "Olhy Tecnologia",
  "homepage": "https://github.com/olhy-services/device-lab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olhy-services/device-lab.git"
  },
  "bugs": {
    "url": "https://github.com/olhy-services/device-lab/issues"
  },
  "keywords": [
    "android",
    "adb",
    "scrcpy",
    "screen-mirroring",
    "devtools",
    "logcat",
    "http-proxy",
    "webcodecs"
  ],
  "type": "module",
  "bin": {
    "device-lab": "./bin/device-lab.mjs"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/cli.ts --dev",
    "start": "tsx src/server/cli.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "postinstall": "fetch-scrcpy-server 3.3.3"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ],
    "patchedDependencies": {
      "mockttp@4.6.5": "patches/mockttp@4.6.5.patch"
    }
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/fetch-scrcpy-server": "^1.0.0",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/stream-extra": "^2.6.1",
    "mockttp": "^4.6.5",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8"
  },
  "packageManager": "pnpm@10.34.5"
}
